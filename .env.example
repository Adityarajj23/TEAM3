# TraceTest AI configuration. Copy to .env (`make env` generates random development passwords).
TRACETEST_ENV=development
# Persistent application data: SQLite database, workflow checkpoints, artifacts, uploads, backups.
TRACETEST_DATA_DIR=./var
TRACETEST_SECRET_KEY=replace-with-a-long-random-value
TRACETEST_CORS_ORIGINS=http://localhost:5173
TRACETEST_COOKIE_SECURE=false

# Local development accounts. Passwords are only read from the environment; leave blank to disable sign-in.
TRACETEST_ADMIN_EMAIL=admin@northwind-hcm.example
TRACETEST_ADMIN_PASSWORD=
TRACETEST_QA_EMAIL=qa.engineer@northwind-hcm.example
TRACETEST_QA_PASSWORD=
TRACETEST_REVIEWER_EMAIL=reviewer@northwind-hcm.example
TRACETEST_REVIEWER_PASSWORD=

# AI providers. live = Groq -> Gemini -> (Ollama) -> explicit failure. mock = deterministic fixtures (tests/CI only).
# Supports multi-key pools with automatic failover and rate-limit rotation (slots 1, 2, 3 or comma-separated).
TRACETEST_LLM_MODE=live
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
# Optional aliases: GROQ_KEY, GROQ_KEY2, GROQ_KEY3
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
# Optional aliases: GEMINI_KEY, GEMINI_KEY2, GEMINI_KEY3
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Execution sandbox
TRACETEST_EXEC_TIMEOUT=60
TRACETEST_EXEC_MEMORY_MB=512
TRACETEST_EXEC_MAX_OUTPUT=256000
# Optional: Chrome/Chromium binary for Playwright tests when bundled browsers are not installed
TRACETEST_CHROMIUM_EXECUTABLE=

# Integrations (optional)
GITHUB_TOKEN=
TRACETEST_CI_TOKEN=
